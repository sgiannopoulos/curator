{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curator",
  "version": "0.1.0",
  "identifier": "com.qaassist.curator",
  "build": {
    "beforeDevCommand": "pnpm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Curator",
        "width": 1240,
        "height": 846,
        "minWidth": 620,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#fffefa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
